<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Top Level Main App Menu -->
        <record id="menu_hr_training_root_app" model="ir.ui.menu">
            <field name="name">Training Requests</field>
            <field name="web_icon">hr_training_request,static/description/icon2.png</field>
            <field name="sequence" eval="25"/>
            <field name="groups_id" eval="[(4, ref('hr_training_request.group_training_requester'))]"/>
        </record>

        <!-- Menu Item 1: Dashboard -->
        <record id="menu_hr_training_dashboard" model="ir.ui.menu">
            <field name="name">Dashboard</field>
            <field name="parent_id" ref="menu_hr_training_root_app"/>
            <field name="action" ref="action_hr_training_dashboard_client"/>
            <field name="sequence" eval="5"/>
            <field name="groups_id" eval="[(4, ref('hr_training_request.group_training_requester'))]"/>
        </record>

        <!-- Menu Item 2: My Requests (Employee) -->
        <record id="menu_hr_training_my_requests" model="ir.ui.menu">
            <field name="name">My Requests</field>
            <field name="parent_id" ref="menu_hr_training_root_app"/>
            <field name="action" ref="action_hr_training_my_requests"/>
            <field name="sequence" eval="10"/>
            <field name="groups_id" eval="[(4, ref('hr_training_request.group_training_requester'))]"/>
        </record>

        <!-- Menu Item 3: Team Requests (Manager) -->
        <record id="menu_hr_training_team_requests" model="ir.ui.menu">
            <field name="name">Team Requests</field>
            <field name="parent_id" ref="menu_hr_training_root_app"/>
            <field name="action" ref="action_hr_training_team_requests"/>
            <field name="sequence" eval="20"/>
            <field name="groups_id" eval="[(4, ref('hr_training_request.group_training_manager_approver'))]"/>
        </record>

        <!-- Menu Item 4: HR Approvals (HR) -->
        <record id="menu_hr_training_hr_approvals" model="ir.ui.menu">
            <field name="name">HR Approvals</field>
            <field name="parent_id" ref="menu_hr_training_root_app"/>
            <field name="action" ref="action_hr_training_hr_approvals"/>
            <field name="sequence" eval="30"/>
            <field name="groups_id" eval="[(4, ref('hr_training_request.group_training_hr_approver'))]"/>
        </record>
    </data>
</odoo>
