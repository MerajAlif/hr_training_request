<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_hr_training_request_form" model="ir.ui.view">
            <field name="name">hr.training.request.form</field>
            <field name="model">hr.training.request</field>
            <field name="arch" type="xml">
                <form string="Training Request">
                    <header>
                        <button name="action_submit" string="Submit" type="object" class="oe_highlight"
                                invisible="not can_submit"/>
                        <button name="action_cancel" string="Cancel" type="object"
                                invisible="not can_cancel"/>
                        <button name="action_manager_approve" string="Approve" type="object" class="oe_highlight"
                                groups="hr_training_request.group_training_manager_approver"
                                invisible="not can_manager_review"/>
                        <button name="action_manager_reject" string="Reject" type="object" class="btn-danger"
                                groups="hr_training_request.group_training_manager_approver"
                                invisible="not can_manager_review"/>
                        <button name="action_hr_approve" string="Final Approve" type="object" class="oe_highlight"
                                groups="hr_training_request.group_training_hr_approver"
                                invisible="not can_hr_review"/>
                        <button name="action_hr_reject" string="Reject" type="object" class="btn-danger"
                                groups="hr_training_request.group_training_hr_approver"
                                invisible="not can_hr_review"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,submitted,manager_approved,hr_approved"/>
                    </header>
                    <sheet>
                        <field name="can_submit" invisible="1"/>
                        <field name="can_cancel" invisible="1"/>
                        <field name="can_manager_review" invisible="1"/>
                        <field name="can_hr_review" invisible="1"/>
                        <group>
                            <group>
                                <field name="employee_id" readonly="state != 'draft'"/>
                                <field name="course_name" readonly="state != 'draft'"/>
                                <field name="start_date" readonly="state != 'draft'"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="cost" readonly="state != 'draft'"/>
                                <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="manager_id"/>
                                <field name="training_provider" readonly="state != 'draft'"/>
                                <field name="end_date" readonly="state != 'draft'"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description" name="description_page">
                                <field name="justification" placeholder="Enter justification for external training/certification..." readonly="state != 'draft'"/>
                            </page>
                            <page string="HR Notes" name="hr_notes_page" groups="hr_training_request.group_training_hr_approver">
                                <field name="hr_notes" placeholder="Internal notes visible only to HR Approvers..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_hr_training_request_tree" model="ir.ui.view">
            <field name="name">hr.training.request.tree</field>
            <field name="model">hr.training.request</field>
            <field name="arch" type="xml">
                <list string="Training Requests"
                      decoration-info="state == 'submitted'"
                      decoration-warning="state == 'manager_approved'"
                      decoration-success="state == 'hr_approved'"
                      decoration-danger="state == 'rejected'"
                      decoration-muted="state == 'cancelled'">
                    <field name="employee_id"/>
                    <field name="course_name"/>
                    <field name="training_provider"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="currency_id" column_invisible="True"/>
                    <field name="cost"/>
                    <field name="state" widget="badge"
                           decoration-info="state == 'submitted'"
                           decoration-warning="state == 'manager_approved'"
                           decoration-success="state == 'hr_approved'"
                           decoration-danger="state == 'rejected'"
                           decoration-muted="state == 'cancelled'"/>
                </list>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_hr_training_request_search" model="ir.ui.view">
            <field name="name">hr.training.request.search</field>
            <field name="model">hr.training.request</field>
            <field name="arch" type="xml">
                <search string="Search Training Requests">
                    <field name="employee_id"/>
                    <field name="course_name"/>
                    <field name="training_provider"/>

                    <!-- Filters -->
                    <filter string="My Requests" name="my_requests" domain="[('employee_id.user_id', '=', uid)]"/>
                    <filter string="My Team" name="my_team" domain="[('manager_id.user_id', '=', uid)]"/>
                    <separator/>
                    <filter string="Draft" name="state_draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Submitted (Pending Manager)" name="state_submitted" domain="[('state', '=', 'submitted')]"/>
                    <filter string="Pending HR Approval" name="pending_hr_approval" domain="[('state', '=', 'manager_approved')]"/>
                    <filter string="HR Approved" name="state_hr_approved" domain="[('state', '=', 'hr_approved')]"/>
                    <filter string="Rejected" name="state_rejected" domain="[('state', '=', 'rejected')]"/>
                    <filter string="Cancelled" name="state_cancelled" domain="[('state', '=', 'cancelled')]"/>

                    <group expand="0" string="Group By">
                        <filter string="Employee" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                        <filter string="Stage / State" name="group_by_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action 1: Training Requests List/Form Action -->
        <record id="action_hr_training_request_all" model="ir.actions.act_window">
            <field name="name">Training Requests</field>
            <field name="res_model">hr.training.request</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_hr_training_request_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new training request!
                </p>
                <p>
                    Submit requests for external training or professional certifications to be routed through manager and HR approvals.
                </p>
            </field>
        </record>

        <record id="action_hr_training_dashboard_client" model="ir.actions.client">
            <field name="name">Training Dashboard</field>
            <field name="tag">hr_training_request.dashboard</field>
        </record>

        <record id="action_hr_training_my_requests" model="ir.actions.act_window">
            <field name="name">My Training Requests</field>
            <field name="res_model">hr.training.request</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_hr_training_request_search"/>
            <field name="context">{'search_default_my_requests': 1}</field>
        </record>

        <record id="action_hr_training_team_requests" model="ir.actions.act_window">
            <field name="name">Team Training Requests</field>
            <field name="res_model">hr.training.request</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_hr_training_request_search"/>
            <field name="context">{'search_default_my_team': 1, 'search_default_state_submitted': 1}</field>
        </record>

        <record id="action_hr_training_hr_approvals" model="ir.actions.act_window">
            <field name="name">HR Training Approvals</field>
            <field name="res_model">hr.training.request</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_hr_training_request_search"/>
            <field name="context">{'search_default_pending_hr_approval': 1}</field>
        </record>
    </data>
</odoo>
