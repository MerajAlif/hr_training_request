<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_employee_form_inherit_training" model="ir.ui.view">
            <field name="name">hr.employee.form.inherit.training</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_open_training_requests"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-graduation-cap">
                        <field name="training_request_count" widget="statinfo" string="Training Requests"/>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
